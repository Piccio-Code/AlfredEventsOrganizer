# App Param

PORT=8080
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgresql Address

DSN=postgresql://[user]:[password]@[address]:[port]/[db_name]

# Firebase Test UID

UID_TEST_USER=test_uid_here
UID_ADMIN_USER=admin_uid_here

# WAHA (WhatsApp HTTP API)

WAHA_BASE_URL=https://waha.example.com
WAHA_X_API_KEY=waha_api_key_here
WAHA_SESSION=default
WAHA_PHONE_NUMBER=39XXXXXXXXXX
WAHA_WEBHOOK_HMAC_KEY=waha_webhook_hmac_key_here

# Telegram

TELEGRAM_ALFRED_API_KEY=telegram_bot_token_here
TELEGRAM_CHAT_ID=telegram_chat_id_here

# GOOSE

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://[user]:[password]@[address]:[port]/[db_name]
GOOSE_MIGRATION_DIR=./migrations
